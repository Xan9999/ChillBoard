digraph ER {
  graph [rankdir=LR, fontname="Helvetica", bgcolor="#1a1a2e"];
  node [shape=none, fontname="Helvetica", fontcolor="white", fontsize=11];
  edge [color="#aaaacc", fontname="Helvetica", fontsize=10, fontcolor="#ccccee"];
  auth_user [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#4466aa"><FONT COLOR="white"><B>auth_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">INTEGER  PK</TD></TR><TR><TD ALIGN="LEFT"><B>password</B></TD><TD ALIGN="LEFT">varchar(128)</TD></TR><TR><TD ALIGN="LEFT"><B>last_login</B></TD><TD ALIGN="LEFT">datetime</TD></TR><TR><TD ALIGN="LEFT"><B>is_superuser</B></TD><TD ALIGN="LEFT">bool</TD></TR><TR><TD ALIGN="LEFT"><B>username</B></TD><TD ALIGN="LEFT">varchar(150)</TD></TR><TR><TD ALIGN="LEFT"><B>last_name</B></TD><TD ALIGN="LEFT">varchar(150)</TD></TR><TR><TD ALIGN="LEFT"><B>email</B></TD><TD ALIGN="LEFT">varchar(254)</TD></TR><TR><TD ALIGN="LEFT"><B>is_staff</B></TD><TD ALIGN="LEFT">bool</TD></TR><TR><TD ALIGN="LEFT"><B>is_active</B></TD><TD ALIGN="LEFT">bool</TD></TR><TR><TD ALIGN="LEFT"><B>date_joined</B></TD><TD ALIGN="LEFT">datetime</TD></TR><TR><TD ALIGN="LEFT"><B>first_name</B></TD><TD ALIGN="LEFT">varchar(150)</TD></TR></TABLE>>];
  boards_backgroundimage [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#4466aa"><FONT COLOR="white"><B>boards_backgroundimage</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">INTEGER  PK</TD></TR><TR><TD ALIGN="LEFT"><B>updated_at</B></TD><TD ALIGN="LEFT">datetime</TD></TR><TR><TD ALIGN="LEFT"><B>user_id</B></TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"><B>background</B></TD><TD ALIGN="LEFT">varchar(100)</TD></TR></TABLE>>];
  boards_comment [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#4466aa"><FONT COLOR="white"><B>boards_comment</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">INTEGER  PK</TD></TR><TR><TD ALIGN="LEFT"><B>text</B></TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT"><B>created_at</B></TD><TD ALIGN="LEFT">datetime</TD></TR><TR><TD ALIGN="LEFT"><B>author_id</B></TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"><B>board_user_id</B></TD><TD ALIGN="LEFT">INTEGER</TD></TR></TABLE>>];
  boards_follow [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#4466aa"><FONT COLOR="white"><B>boards_follow</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">INTEGER  PK</TD></TR><TR><TD ALIGN="LEFT"><B>created_at</B></TD><TD ALIGN="LEFT">datetime</TD></TR><TR><TD ALIGN="LEFT"><B>follower_id</B></TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"><B>following_id</B></TD><TD ALIGN="LEFT">INTEGER</TD></TR></TABLE>>];
  boards_imagepost [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#4466aa"><FONT COLOR="white"><B>boards_imagepost</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">INTEGER  PK</TD></TR><TR><TD ALIGN="LEFT"><B>image</B></TD><TD ALIGN="LEFT">varchar(100)</TD></TR><TR><TD ALIGN="LEFT"><B>caption</B></TD><TD ALIGN="LEFT">varchar(200)</TD></TR><TR><TD ALIGN="LEFT"><B>created_at</B></TD><TD ALIGN="LEFT">datetime</TD></TR><TR><TD ALIGN="LEFT"><B>user_id</B></TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"><B>pos_x</B></TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"><B>pos_y</B></TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"><B>height</B></TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"><B>width</B></TD><TD ALIGN="LEFT">INTEGER</TD></TR></TABLE>>];
  boards_profileimage [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#4466aa"><FONT COLOR="white"><B>boards_profileimage</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">INTEGER  PK</TD></TR><TR><TD ALIGN="LEFT"><B>updated_at</B></TD><TD ALIGN="LEFT">datetime</TD></TR><TR><TD ALIGN="LEFT"><B>user_id</B></TD><TD ALIGN="LEFT">INTEGER</TD></TR><TR><TD ALIGN="LEFT"><B>image</B></TD><TD ALIGN="LEFT">varchar(100)</TD></TR></TABLE>>];

  boards_backgroundimage -> auth_user [label="user_id -&gt; id"];
  boards_comment -> auth_user [label="board_user_id -&gt; id"];
  boards_comment -> auth_user [label="author_id -&gt; id"];
  boards_follow -> auth_user [label="following_id -&gt; id"];
  boards_follow -> auth_user [label="follower_id -&gt; id"];
  boards_imagepost -> auth_user [label="user_id -&gt; id"];
  boards_profileimage -> auth_user [label="user_id -&gt; id"];
}